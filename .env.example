# =================================================================
# Keepr (usekeepr.com) - Environment Configuration
# Silicon Valley Standard Cloud & AI Infrastructure
# =================================================================

# Application Metadata
APP_NAME=Keepr
APP_DOMAIN=usekeepr.com
SUPPORT_EMAIL=care@usekeepr.com
SUPPORT_PHONE="+91 9870530066"
BOT_PHONE=919870530066

# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=https://usekeepr.com

# WhatsApp Messaging Gateway (meta = official cloud API [1,000 free/mo, ₹0 fixed cost], ultramsg = secondary)
WHATSAPP_PRIMARY_GATEWAY=meta

# Meta WhatsApp Cloud API (Primary Tier-1 Gateway)
# https://developers.facebook.com/
WHATSAPP_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=keepr_secure_verify_token_2026

# UltraMsg (Optional Pluggable Secondary Driver)
ULTRAMSG_INSTANCE_ID=instance190648
ULTRAMSG_TOKEN=your_ultramsg_token_here

# Google Gemini API (Multimodal Vision & Voice Extraction)
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Distributed Cache & Queues (Upstash / Redis Free Tier)
# Optional: Falls back to in-memory store if not provided
REDIS_URL=redis://default:password@your-upstash-redis.upstash.io:6379

# Supabase (PostgreSQL & Encrypted Storage)
# https://supabase.com/
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_STORAGE_BUCKET=keepr-vault

# Razorpay (Subscription & Payment Links)
# https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=keepr_rzp_secure_webhook_2026

# Security Encryption Key (AES-256 for local file encryption before cloud storage)
ENCRYPTION_SECRET=e7b4c91a82f3d5e0a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9
